# Server
HOST=0.0.0.0
PORT=3000

# Comma-separated frontend origins. Add the company's HTTPS origin here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost

# PostgreSQL production connection. Keep empty to use JSON only for local fallback.
DATABASE_URL=
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_AUTO_SEED=false

# Legacy JSON fallback and optional seed source.
DATABASE_DIR=./database
SEED_FILE=./database/seed.json

# Security durations are expressed in milliseconds.
SESSION_TTL_MS=43200000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_LOCK_MS=900000
MAX_REQUEST_BODY_BYTES=1048576
