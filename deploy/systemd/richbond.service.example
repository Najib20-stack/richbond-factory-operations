[Unit]
Description=Richbond Operations Usine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=richbond
Group=richbond
WorkingDirectory=/opt/richbond
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
EnvironmentFile=/etc/richbond/richbond.env
ExecStart=/usr/bin/node backend/server.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
