limit_req_zone $binary_remote_addr zone=richbond_login:10m rate=10r/m;

server {
    listen 80;
    server_name operations.example.richbond.ma;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name operations.example.richbond.ma;

    ssl_certificate /etc/ssl/richbond/fullchain.pem;
    ssl_certificate_key /etc/ssl/richbond/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /api/login {
        limit_req zone=richbond_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
