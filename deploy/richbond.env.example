NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Store the real value in the server secret manager, never in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_AUTO_SEED=false

# Replace with the exact HTTPS URL supplied by the company.
CORS_ORIGINS=https://operations.example.richbond.ma,https://localhost,capacitor://localhost

SESSION_TTL_MS=43200000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_LOCK_MS=900000
MAX_REQUEST_BODY_BYTES=1048576
