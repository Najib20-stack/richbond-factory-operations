{
  "name": "richbond-factory-operations",
  "version": "1.0.0",
  "description": "Application full-stack de gestion des operations d'usine Richbond.",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "postinstall": "npm ci --prefix backend",
    "build": "npm run build --prefix frontend",
    "prestart": "npm run build",
    "start": "node backend/server.mjs",
    "dev": "npm run build && node backend/server.mjs",
    "android:sync": "npm run build:android --prefix frontend && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:build": "npm run android:sync && cap build android",
    "cloudflare:dev": "npm run build && wrangler dev",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "cloudflare:tail": "wrangler tail",
    "check": "npm run check:all --prefix backend && npm run check --prefix frontend",
    "check:backend": "npm run check:all --prefix backend",
    "check:frontend": "npm run check --prefix frontend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "data:audit": "npm run data:audit --prefix backend",
    "data:backup": "npm run data:backup --prefix backend",
    "data:restore": "npm run data:restore --prefix backend --",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:status": "npm run db:status --prefix backend",
    "db:import": "npm run db:import --prefix backend --",
    "db:audit": "npm run db:audit --prefix backend",
    "db:export": "npm run db:export --prefix backend --",
    "db:backup": "npm run db:backup --prefix backend --",
    "admin:create": "npm run admin:create --prefix backend"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "wrangler": "^4.119.0"
  }
}
